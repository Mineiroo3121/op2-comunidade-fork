<section class="op2-painel op2-painel--condicao tab {{tabs.condicao.cssClass}}" data-group="principal" data-tab="condicao">
  <div class="op2-painel__topo op2-efeitos__topo"><span class="op2-tag op2-tag--secao">{{localize "OP2.Secao.Condicoes"}}</span>
    {{#if editavel}}<button type="button" class="op2-botao op2-botao--fantasma" data-action="adicionarCondicao"><i class="fa-solid fa-plus"></i> {{localize "OP2.Condicao.Adicionar"}}</button>{{/if}}
  </div>
  {{#if condicoesAtivas.length}}<ul class="op2-efeitos__lista">{{#each condicoesAtivas}}
    <li class="op2-efeito-ativo"><span class="op2-efeito-ativo__marcador"></span><strong>{{rotulo}}</strong>
      {{#if @root.editavel}}<button type="button" class="op2-botao-icone" data-action="alternarCondicao" data-condicao="{{chave}}" aria-label="{{localize 'OP2.Condicao.Remover'}}" data-tooltip="{{localize 'OP2.Condicao.Remover'}}"><i class="fa-solid fa-xmark"></i></button>{{/if}}
    </li>{{/each}}</ul>{{else}}<p class="op2-vazio">{{localize "OP2.Condicao.NenhumaAtiva"}}</p>{{/if}}
  <div class="op2-condicao__linha"><span class="op2-tag op2-tag--secao">{{localize "OP2.Campo.Patamar"}}</span><select name="system.patamar" {{#unless editavel}}disabled{{/unless}}>{{#each patamares}}<option value="{{chave}}" {{#if atual}}selected{{/if}}>{{rotulo}}</option>{{/each}}</select></div>
  {{#if temAnalise}}<div class="op2-condicao__linha"><span class="op2-tag op2-tag--secao">{{localize "OP2.Analise.Titulo"}}</span><input type="number" name="system.estado.marcadores" value="{{sistema.estado.marcadores}}" min="0" max="{{maxMarcadores}}" {{#unless editavel}}disabled{{/unless}}> / {{maxMarcadores}}{{#if editavel}}<button type="button" class="op2-botao op2-botao--pequeno" data-action="analisar">{{localize "OP2.Analise.Acao"}}</button>{{/if}}</div>{{/if}}
  <div class="op2-condicao__linha"><span class="op2-tag op2-tag--secao">{{localize "OP2.Campo.Armadura"}}</span><strong>{{sistema.armadura.disponivel}} / {{sistema.armadura.total}}</strong><label>{{localize "OP2.Campo.ArmaduraGasta"}} <input type="number" name="system.estado.armaduraGasta" value="{{sistema.estado.armaduraGasta}}" min="0" {{#unless editavel}}disabled{{/unless}}></label><span class="op2-ajuda">{{localize "OP2.Campo.ArmaduraAjuda"}}</span></div>
  <div class="op2-condicao__linha"><span class="op2-tag op2-tag--secao">{{localize "OP2.Secao.Testes"}}</span><label>{{localize "OP2.Lesao.TesteTitulo"}} <input type="number" name="system.estado.testesFerimento" value="{{sistema.estado.testesFerimento}}" min="0" {{#unless editavel}}disabled{{/unless}}></label><label>{{localize "OP2.TraumaBeta.TesteTitulo"}} <input type="number" name="system.estado.testesTrauma" value="{{sistema.estado.testesTrauma}}" min="0" {{#unless editavel}}disabled{{/unless}}></label>{{#if editavel}}<button type="button" class="op2-botao op2-botao--pequeno" data-action="testeQueda" data-tipo="lesao">{{localize "OP2.Lesao.TesteTitulo"}}</button><button type="button" class="op2-botao op2-botao--pequeno" data-action="testeQueda" data-tipo="trauma">{{localize "OP2.TraumaBeta.TesteTitulo"}}</button><button type="button" class="op2-botao op2-botao--pequeno" data-action="tabelaQueda" data-tipo="lesao">{{localize "OP2.Lesao.RolarTabela"}}</button><button type="button" class="op2-botao op2-botao--pequeno" data-action="tabelaQueda" data-tipo="trauma">{{localize "OP2.TraumaBeta.RolarTabela"}}</button>{{/if}}</div>
  <span class="op2-tag op2-tag--secao">{{localize "OP2.Dialog.Teste.Guardados"}}</span><ul class="op2-condicao__lista">{{#each bonus}}<li>+{{dado}} — {{rotulo}} {{#if ../editavel}}<button type="button" class="op2-botao op2-botao--fantasma" data-action="tirarBonus" data-indice="{{@index}}"><i class="fa-solid fa-xmark"></i></button>{{/if}}</li>{{/each}}</ul>
  {{#if editavel}}<button type="button" class="op2-botao op2-botao--fantasma" data-action="porBonus"><i class="fa-solid fa-plus"></i> {{localize "OP2.Condicao2.PorDado"}}</button>{{/if}}
  <span class="op2-tag op2-tag--secao">{{localize "OP2.Secao.Lesoes"}}</span><ul class="op2-condicao__lista">{{#each lesoes}}<li data-tooltip="{{efeito}}">{{nome}} {{#if ../editavel}}<button type="button" class="op2-botao op2-botao--fantasma" data-action="curar" data-lista="lesoes" data-indice="{{@index}}"><i class="fa-solid fa-xmark"></i></button>{{/if}}</li>{{/each}}</ul>
  {{#if editavel}}<div class="op2-condicao__linha" data-nova="lesoes"><select name="novaLista">{{#each opcoesLesao}}<option value="{{chave}}">{{rotulo}}</option>{{/each}}</select><button type="button" class="op2-botao op2-botao--fantasma" data-action="anotar" data-lista="lesoes"><i class="fa-solid fa-plus"></i> {{localize "OP2.Condicao2.Anotar"}}</button></div>{{/if}}
  <span class="op2-tag op2-tag--secao">{{localize "OP2.Secao.Traumas"}}</span><ul class="op2-condicao__lista">{{#each traumas}}<li data-tooltip="{{efeito}}">{{nome}} {{#if ../editavel}}<button type="button" class="op2-botao op2-botao--fantasma" data-action="curar" data-lista="traumas" data-indice="{{@index}}"><i class="fa-solid fa-xmark"></i></button>{{/if}}</li>{{/each}}</ul>
  {{#if editavel}}<div class="op2-condicao__linha" data-nova="traumas"><select name="novaLista">{{#each opcoesTrauma}}<option value="{{chave}}">{{rotulo}}</option>{{/each}}</select><button type="button" class="op2-botao op2-botao--fantasma" data-action="anotar" data-lista="traumas"><i class="fa-solid fa-plus"></i> {{localize "OP2.Condicao2.Anotar"}}</button></div>{{/if}}
</section>
